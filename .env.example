# Copy to `.env.local` and fill in real values. `.env*` files are gitignored except this one.
# Everything here is server-only. Browser-visible values need the `NEXT_PUBLIC_` prefix and must not be secrets.

DATABASE_URL=postgresql://tennismate:tennismate@localhost:5432/tennismate
REDIS_URL=redis://localhost:6379
EMAIL_API_KEY=replace-me

S3_BUCKET=tennismate-dev
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Only for non-AWS S3-compatible providers (MinIO, R2)
S3_ENDPOINT=
