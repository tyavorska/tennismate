# Copy to `.env.local` and fill in real values. `.env*` files are gitignored except this one.
# Everything here is server-only. Browser-visible values need the `NEXT_PUBLIC_` prefix and must not be secrets.

# SQLite database file, created on first use. Relative to the project root.
DATABASE_PATH=data/tennismate.db
REDIS_URL=redis://localhost:6379
EMAIL_API_KEY=replace-me

S3_BUCKET=tennismate-dev
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Only for non-AWS S3-compatible providers (MinIO, R2)
S3_ENDPOINT=

# Realtime messaging (Socket.IO, started with `npm run realtime`).
# The port the realtime server listens on, and the web app origin it accepts connections from.
REALTIME_PORT=4000
REALTIME_ALLOWED_ORIGIN=http://localhost:3000
# Where the browser connects. Public, so no secrets.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
