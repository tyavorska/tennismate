{
  "name": "tennismate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prepare-build-db.mjs",
    "build": "next build",
    "start": "next start",
    "realtime": "tsx --tsconfig scripts/tsconfig.realtime.json scripts/realtime.ts",
    "realtime:dev": "tsx watch --tsconfig scripts/tsconfig.realtime.json scripts/realtime.ts",
    "lint": "eslint && stylelint \"src/**/*.css\"",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:cities": "NODE_ENV=production tsx --conditions=react-server scripts/import-cities.ts",
    "import:courts": "NODE_ENV=production tsx --conditions=react-server scripts/import-courts.ts",
    "eval:review": "tsx .claude/skills/let-code-review/evals/run.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@sentry/nextjs": "^11.15.0",
    "@sentry/node": "^11.15.0",
    "@tanstack/react-query": "^5.105.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "temporal-polyfill": "^1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.7",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
