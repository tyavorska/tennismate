# TennisMate environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env*` files are gitignored; only this example is committed. Never commit real secrets.
#
# Variables here are server-only. Anything that must reach the browser needs the
# `NEXT_PUBLIC_` prefix and must never contain secrets.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://tennismate:tennismate@localhost:5432/tennismate

# --- Cache / queues ---------------------------------------------------------
# Redis connection string
REDIS_URL=redis://localhost:6379

# --- Email ------------------------------------------------------------------
# API key for the transactional email provider
EMAIL_API_KEY=replace-me

# --- Object storage (S3-compatible) -----------------------------------------
S3_BUCKET=tennismate-dev
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Optional: only needed for non-AWS S3-compatible providers (MinIO, R2, etc.)
S3_ENDPOINT=
