+/** The display name of another player, shown in the invite dialog. */
+export function getPlayerName(user: User, playerId: string): string {
+  requireProfile(user);
+  const row = db.prepare('SELECT name FROM profiles WHERE user_id = ?').get(playerId);
+  if (row === undefined) {
+    throw new DomainError('notFound', { message: 'This player no longer exists.' });
+  }
+  return z.object({ name: z.string() }).parse(row).name;
+}
